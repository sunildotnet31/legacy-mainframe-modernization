//DAILYPOST JOB (ACCT),'DAILY POST',CLASS=A,MSGCLASS=X
//* Validate and post daily transaction feed
//VALIDATE EXEC PGM=TXNVALID
//STEPLIB  DD DSN=YOUR.LOADLIB,DISP=SHR
//INPUT    DD DSN=YOUR.DAILY.TXN.INPUT,DISP=SHR
//OUTPUT   DD DSN=YOUR.DAILY.TXN.VALID,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//POST     EXEC PGM=TXNPOST,COND=(0,NE,VALIDATE)
//STEPLIB  DD DSN=YOUR.LOADLIB,DISP=SHR
//SYSOUT   DD SYSOUT=*
