//STMTGEN  JOB (ACCT),'STATEMENT GEN',CLASS=A,MSGCLASS=X
//* Produce monthly statement extract for downstream delivery
//EXTRACT  EXEC PGM=STMTGEN
//STEPLIB  DD DSN=YOUR.LOADLIB,DISP=SHR
//STMTFILE DD DSN=YOUR.STATEMENT.EXTRACT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,10)),DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SORT     EXEC PGM=SORT,COND=(0,NE,EXTRACT)
//SORTIN   DD DSN=YOUR.STATEMENT.EXTRACT,DISP=SHR
//SORTOUT  DD DSN=YOUR.STATEMENT.SORTED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,10)),DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,16,CH,A)
/*
//SYSOUT   DD SYSOUT=*
