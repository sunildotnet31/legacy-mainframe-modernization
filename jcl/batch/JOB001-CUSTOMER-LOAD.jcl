//CUSTLOAD JOB (ACCT),'CUSTOMER LOAD',CLASS=A,MSGCLASS=X
//* Load staged customer records into CUSTOMER
//STEP01   EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2T)
  RUN PROGRAM(CUSTLOAD) PLAN(CUSTPLAN) -
      LIB('YOUR.LOADLIB')
  END
