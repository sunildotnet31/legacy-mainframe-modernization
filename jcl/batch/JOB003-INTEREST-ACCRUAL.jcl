//INTACCR  JOB (ACCT),'INTEREST ACCRUAL',CLASS=A,MSGCLASS=X
//* Calculate daily interest and create posting work file
//ACCRUAL  EXEC PGM=INTCALC
//STEPLIB  DD DSN=YOUR.LOADLIB,DISP=SHR
//RATEFILE DD DSN=YOUR.RATE.FILE,DISP=SHR
//WORKFILE DD DSN=YOUR.INTEREST.WORK,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5)),DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//POST     EXEC PGM=INTPOST,COND=(0,NE,ACCRUAL)
//STEPLIB  DD DSN=YOUR.LOADLIB,DISP=SHR
//SYSOUT   DD SYSOUT=*
