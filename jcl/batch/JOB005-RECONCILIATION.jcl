//RECON    JOB (ACCT),'DAILY RECON',CLASS=A,MSGCLASS=X
//* Reconcile internal postings against external settlement feed
//MATCH    EXEC PGM=RECONRUN
//STEPLIB  DD DSN=YOUR.LOADLIB,DISP=SHR
//INTERNAL DD DSN=YOUR.INTERNAL.POSTINGS,DISP=SHR
//EXTERNAL DD DSN=YOUR.EXTERNAL.SETTLEMENT,DISP=SHR
//MATCHED  DD DSN=YOUR.RECON.MATCHED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5)),DCB=(RECFM=FB,LRECL=220,BLKSIZE=0)
//EXCEPT   DD DSN=YOUR.RECON.EXCEPTIONS,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2)),DCB=(RECFM=FB,LRECL=220,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
